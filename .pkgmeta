package-as: AggeHealBot

enable-nolib-creation: no

tools-used:
    - libstub
    - callbackhandler
    - libdatabroker-1-1
    - libdbicon-1-0

move-folders:
    AggeHealBot/AggeHealBot: AggeHealBot

ignore:
    - assets
    - README.md
    - CHANGELOG.md
    - tests
    - tools

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
